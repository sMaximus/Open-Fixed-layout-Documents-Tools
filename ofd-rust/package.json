{
  "name": "ofd-viewer",
  "version": "1.0.0",
  "description": "OFD 文档查看器组件 (基于 Rust WASM)",
  "main": "dist/ofd-viewer.umd.js",
  "module": "dist/ofd-viewer.esm.js",
  "exports": {
    ".": {
      "import": "./dist/ofd-viewer.esm.js",
      "require": "./dist/ofd-viewer.umd.js"
    },
    "./bundle": {
      "import": "./dist/ofd-viewer.bundle.esm.js",
      "require": "./dist/ofd-viewer.bundle.umd.js"
    },
    "./pkg/*": "./pkg/*"
  },
  "files": [
    "dist/",
    "pkg/",
    "src-js/"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir target/wasm-pack-pkg && node scripts/sync-wasm-artifact.mjs",
    "build:js": "rollup -c rollup.config.mjs",
    "build": "npm run build:wasm && npm run build:js",
    "test:bundle": "node ./tests-js/bundle-artifacts.test.mjs",
    "dev": "node server.js"
  },
  "devDependencies": {
    "rollup": "^4.0.0",
    "@rollup/plugin-terser": "^0.4.0"
  },
  "keywords": [
    "ofd",
    "viewer",
    "document",
    "wasm"
  ],
  "license": "MIT"
}
